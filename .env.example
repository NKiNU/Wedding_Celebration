NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=      # server only, never import into client code
ADMIN_PASSCODE=                 # admin screen access
DEVICE_TOKEN_PEPPER=            # random 32+ chars, used when hashing device tokens
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=                    # dev only: S3-compatible endpoint instead of R2, e.g. local Supabase Storage
R2_REGION=                      # dev only, defaults to "auto"
NEXT_PUBLIC_MEDIA_BASE_URL=     # R2 public custom domain, e.g. https://media.example.com
EVENT_SLUG=demo
CRON_SECRET=                    # 16+ chars, guards /api/cron/sweep
